# AI assisted development
# Copy to backend/.env and frontend/.env as needed (see SETUP.md)

# --- Backend (backend/.env) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transparency?schema=public
PORT=3000
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Demo planner + GitHub UI without live keys
DEMO_DATA=true

# Microsoft OAuth (optional)
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_DEFAULT_ROLE=CLIENT

# Microsoft Graph (Planner) — pick one approach
# Static user/delegated token for development (short-lived)
GRAPH_ACCESS_TOKEN=
# Or app-only (client credentials) — also uses MICROSOFT_* above

# GitHub API
GITHUB_TOKEN=

# Daily notification cron (creates in-app notifications)
ENABLE_ALERT_CRON=false

# OpenAI for client-friendly weekly narrative (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:3000/api
# GitHub Pages CI: set repo secret VITE_API_URL to your deployed API (see SETUP.md).
# Local production-style build: VITE_BASE=/<repo>/ npm run build
